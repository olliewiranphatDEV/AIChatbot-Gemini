# Copy to `.env.local` and fill in the values (Vite loads it on `npm run dev` / `npm run build`).
# Real values stay in `.env.local`, which is git-ignored.

# Firebase Web app configuration (Firebase Console > Project settings > General > Your apps).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Optional: leave empty when using real Google sign-in.
VITE_FIREBASE_AUTH_EMULATOR_URL=

# Backend API base URL, no trailing slash. Local backend default:
VITE_API_BASE_URL=http://localhost:3001
