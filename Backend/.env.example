# Non-secret settings for local development.
NODE_ENV=development
PORT=3001

# Allowed frontend origins, comma-separated.
# No paths or trailing slashes.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Gemini Developer API key (https://aistudio.google.com/apikey). Keep it blank here:
# put the real key only in Backend/.env.local or in Render's environment variables.
GEMINI_API_KEY=

# Model used for chat replies. Optional; this is the default.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_LIVE_MODEL=gemini-3.8-live
TRUST_PROXY_HOPS=0
